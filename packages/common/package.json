{
  "name": "@ethdebug/common",
  "version": "0.1.0-preview.2",
  "description": "Shared runtime code for the ethdebug/format packages",
  "main": "dist/src/index.js",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ethdebug/format.git",
    "directory": "packages/common"
  },
  "license": "MIT",
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "imports": {
    "#raw": {
      "types": "./src/raw.ts",
      "default": "./dist/src/raw.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc --build tsconfig.build.json",
    "prepare": "yarn build",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "watch": "tsc --build --watch",
    "test": "vitest"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "ethereum-cryptography": "^2.2.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
