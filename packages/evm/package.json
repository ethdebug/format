{
  "name": "@ethdebug/evm",
  "version": "0.1.0-1",
  "description": "EVM execution and state access for ethdebug/format",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ethdebug/format.git",
    "directory": "packages/evm"
  },
  "license": "MIT",
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo"
  ],
  "engines": {
    "node": ">=20"
  },
  "imports": {
    "#executor": {
      "types": "./src/executor.ts",
      "default": "./dist/src/executor.js"
    },
    "#machine": {
      "types": "./src/machine.ts",
      "default": "./dist/src/machine.js"
    },
    "#trace": {
      "types": "./src/trace.ts",
      "default": "./dist/src/trace.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc --build tsconfig.build.json",
    "prepare": "yarn build",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "watch": "tsc --watch --preserveWatchOutput",
    "test": "vitest run"
  },
  "dependencies": {
    "@ethdebug/pointers": "^0.1.0-1",
    "@ethereumjs/common": "^10.0.0",
    "@ethereumjs/evm": "^10.0.0",
    "@ethereumjs/statemanager": "^10.0.0",
    "@ethereumjs/util": "^10.0.0",
    "ethereum-cryptography": "^3.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0",
    "vitest": "^3.2.4"
  },
  "publishConfig": {
    "access": "public"
  }
}
